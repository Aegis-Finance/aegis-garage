# Keystatic GitHub App (production admin at /keystatic)
# Use a GitHub App — NOT a classic OAuth App. Create via local dev setup (see README).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Generate with: openssl rand -base64 32
# KEYSTATIC_SECRET must be at least 32 characters.

# Astro Node server (optional — defaults shown)
HOST=0.0.0.0
PORT=4321
