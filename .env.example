# Keystatic GitHub OAuth (production admin at /keystatic)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Generate with: openssl rand -base64 32
# KEYSTATIC_SECRET must be at least 32 characters.

# Astro Node server (optional — defaults shown)
HOST=0.0.0.0
PORT=4321
